<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark"><title>Plaguefall — Atlas das fases 1 a 16</title>
<style>
:root{--bg:#0c1013;--panel:#141a1e;--line:#2a3338;--text:#e9e6de;--muted:#a6b0b4;--accent:#edbc72;--green:#93cdb0;--blue:#86c6ed}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 system-ui,-apple-system,sans-serif}button,input,select{font:inherit}button,select{border:1px solid var(--line);border-radius:6px;color:var(--text);background:#1c2429;padding:8px 11px}button{cursor:pointer}button:hover{border-color:var(--accent);color:#ffe1b4}button:disabled{opacity:.35;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,canvas:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button[aria-pressed=true]{background:#3b3022;border-color:var(--accent);color:#ffe2b9}.brand{padding:22px 28px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:18px}.eyebrow{text-transform:uppercase;letter-spacing:.19em;font-size:10px;font-weight:700;color:var(--accent)}h1{font-size:23px;letter-spacing:-.04em;margin:3px 0}p{margin:8px 0}.muted{color:var(--muted)}.badges{display:flex;gap:9px;flex-wrap:wrap}.badge{padding:5px 9px;background:#19231f;border:1px solid #34483d;border-radius:4px;color:var(--green);font-size:11px}.layout{display:grid;grid-template-columns:225px minmax(0,1fr);min-height:calc(100vh - 110px)}aside{border-right:1px solid var(--line);padding:20px 12px}.side-title{padding:0 9px 12px}.stage-list{display:flex;flex-direction:column;gap:5px}.stage-btn{display:grid;grid-template-columns:33px 1fr;text-align:left;align-items:center;gap:6px;padding:10px 9px;background:transparent;border-color:transparent}.stage-btn b{color:var(--accent);font-size:15px}.stage-btn span{font-size:11px;line-height:1.35}.side-foot{font-size:11px;padding:15px 9px;border-top:1px solid var(--line);margin-top:20px;color:var(--muted)}main{padding:24px 26px;min-width:0;max-width:1900px}.stage-head{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;margin-bottom:16px}h2{font-size:29px;line-height:1.15;letter-spacing:-.04em;margin:6px 0}.stage-head p{margin:7px 0 0;color:var(--muted)}.navigation{display:flex;gap:5px}.goal{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:20px}.goal>div{border-left:2px solid #3a494e;padding-left:12px}.goal strong{font-size:10px;letter-spacing:.13em;color:var(--accent);text-transform:uppercase}.goal p{margin:4px 0;font-size:12px}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 348px;gap:18px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:9px;overflow:hidden}.panel-head{padding:12px 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:10px}.panel-head strong{font-size:12px}.toolbar{display:flex;gap:5px;align-items:center;flex-wrap:wrap}.toolbar button{font-size:11px;padding:5px 8px}.map-wrap{height:490px;position:relative;overflow:hidden;background:#080c0f;touch-action:none}.map-wrap canvas{display:block;width:100%;height:100%;cursor:grab}.map-wrap canvas:active{cursor:grabbing}.map-hint{position:absolute;left:12px;bottom:10px;font-size:10px;color:#ccd1d3;background:#0b1014e8;border:1px solid #344149;border-radius:5px;padding:5px 9px;pointer-events:none}.coords{position:absolute;top:10px;right:12px;background:#0b1014d9;padding:4px 7px;font:10px ui-monospace,monospace;color:#c2c9cc;border-radius:4px}.layers{display:flex;gap:12px;flex-wrap:wrap;padding:12px 14px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}.layers label{cursor:pointer;display:flex;align-items:center;gap:5px}.layers input{accent-color:var(--accent)}.legend{font-size:10px;color:var(--muted);padding:0 14px 12px}.legend span{margin-right:12px}.inspector{padding:13px}.screen{display:block;width:100%;aspect-ratio:320/224;image-rendering:pixelated;background:#000;border:1px solid #39444a}.tabs{display:flex;gap:5px;margin-bottom:10px}.tabs button{flex:1;font-size:11px;padding:6px}.screen-info{font-size:11px;color:var(--muted);min-height:47px;margin:10px 0}.sliders{display:grid;grid-template-columns:16px 1fr 38px;gap:7px;align-items:center;font-size:11px}.sliders output{text-align:right;color:var(--accent);font:11px ui-monospace,monospace}.sliders input{width:100%;accent-color:var(--accent)}.jump{display:flex;gap:5px;margin-top:11px}.jump button{font-size:11px;flex:1;padding:6px}.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0 0}.stat{padding:8px 10px;border:1px solid var(--line);border-radius:5px}.stat small{font-size:10px;color:var(--muted);display:block}.stat b{font:13px ui-monospace,monospace;color:#ded9c9}.view-controls{display:flex;align-items:center;gap:6px;margin-top:9px}.view-controls button{padding:5px 9px}.view-controls select{min-width:0;width:100%;font-size:11px;padding:6px}.points{padding:13px 14px;max-height:180px;overflow:auto;display:flex;flex-wrap:wrap;gap:6px}.points button{font-size:10px;padding:4px 7px}.points button[data-kind=start]{color:var(--green)}.thumb-section{margin-top:20px}.thumb-section>div:first-child{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}.thumb-section h3{font-size:13px;margin:0}.thumb-section p{font-size:11px;color:var(--muted);margin:0}.filmstrip{display:flex;gap:8px;overflow-x:auto;padding:3px 2px 10px}.thumb{flex:0 0 150px;padding:4px;border-radius:5px;text-align:left;background:#11171b}.thumb img{display:block;width:140px;aspect-ratio:320/224;image-rendering:pixelated}.thumb span{display:block;font:10px ui-monospace,monospace;color:var(--muted);padding:5px 3px 1px}details{margin-top:18px;padding:12px 14px;border:1px solid var(--line);border-radius:7px;color:var(--muted);font-size:11px}summary{cursor:pointer;color:var(--text)}details p{max-width:1000px}code{font-size:10px;overflow-wrap:anywhere}.fullscreen{position:fixed;inset:14px;z-index:10;display:flex;flex-direction:column;box-shadow:0 0 0 50px #000b}.fullscreen .map-wrap{height:auto;flex:1}.empty{padding:30px;color:var(--accent)}@media(min-width:1700px){.workspace{grid-template-columns:minmax(0,1fr) 410px}.map-wrap{height:600px}}@media(max-width:1150px){.layout{grid-template-columns:182px minmax(0,1fr)}main{padding:20px 16px}.workspace{grid-template-columns:minmax(0,1fr)}.inspector-layout{display:grid;grid-template-columns:minmax(0,340px) 1fr;gap:16px}.map-wrap{height:430px}.points{max-height:140px}}@media(max-width:650px){.brand{padding:15px 16px;display:block}.badges{margin-top:10px}.layout{display:block}aside{border:0;border-bottom:1px solid var(--line);padding:10px}.side-title,.side-foot{display:none}.stage-list{flex-direction:row;overflow:auto}.stage-btn{display:block;min-width:49px;text-align:center;padding:8px}.stage-btn span{display:none}.stage-head{display:block}.navigation{margin-top:12px}.goal{grid-template-columns:1fr;gap:10px}h2{font-size:25px}.inspector-layout{display:block}.map-wrap{height:350px}.thumb-section>div:first-child{display:block}.toolbar{gap:3px}.panel-head{padding:10px}.map-hint{font-size:9px}.fullscreen{inset:5px}.brand h1{font-size:21px}}
</style>
<style>
.revision-summary{padding:10px 13px;margin:0 0 18px;border:1px solid #34483d;border-radius:6px;color:var(--green);background:#15201b;font-size:12px}.revision-card{margin:0 0 18px;padding:13px 15px;background:#171d22;border:1px solid var(--line);border-radius:7px}.revision-heading{display:flex;align-items:center;gap:10px}.revision-heading strong{font-size:12px}.revision-tag{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--accent)}.revision-card ul{padding-left:18px;margin:9px 0 0;font-size:12px;color:#cbd0d0}.revision-card li{margin:5px 0}.validation{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}.validation p{font-size:11px;color:var(--green);margin:3px 0}.validation small{font-size:10px;color:var(--muted)}.evidence-section{margin-top:20px}.evidence-body{display:grid;grid-template-columns:360px minmax(0,1fr);gap:20px;padding:14px}.evidence-image{display:block;image-rendering:pixelated;width:100%;aspect-ratio:320/224;border:1px solid var(--line)}.evidence-caption{font-size:12px;color:var(--accent);margin-top:8px}.evidence-choices{display:flex;flex-wrap:wrap;gap:7px;align-content:flex-start}.evidence-choices button{font-size:11px;text-align:left}.stage-btn[data-status=new] b{color:var(--green)}.stage-btn[data-status=updated] b{color:#ffd28b}@media(max-width:850px){.evidence-body{grid-template-columns:1fr}.evidence-image{max-width:480px}}[hidden]{display:none!important}
</style>
</head>
<body>
<header class="brand"><div><div class="eyebrow">Plaguefall / Arquivo de campo</div><h1>Atlas das fases 01 — 16</h1><div class="muted" style="font-size:12px">Explore os cenários da ROM capturada, do pátio ao estaleiro.</div></div><div class="badges"><span class="badge">16 fases · 19 versões</span><span class="badge" id="captureBadge"></span><span class="badge">HTML offline</span></div></header>
<div class="layout"><aside><div class="side-title eyebrow">Escolha uma fase</div><nav class="stage-list" id="stages" aria-label="Fases e variantes"></nav><div class="side-foot">2A / 2B · Igreja<br>6A / 6B · Evacuação<br>13A / 13B · Dinorah<br><br>Setas: mover a janela<br>+ / −: zoom no mapa<br>Esc: sair da ampliação</div></aside>
<main>
<div class="stage-head"><div><div class="eyebrow" id="stageLabel"></div><h2 id="title"></h2><p id="place"></p></div><div class="navigation"><button id="previous" aria-label="Fase anterior">← Anterior</button><button id="next" aria-label="Próxima fase">Próxima →</button></div></div>
<p class="revision-summary" id="revisionSummary"></p>
<section class="goal" aria-label="Missão e rota"><div><strong>Objetivo</strong><p id="objective"></p></div><div><strong>Contexto / variante</strong><p id="note"></p></div></section>
<section class="revision-card" aria-label="Novidades da fase"><div class="revision-heading"><strong>O que mudou nesta revisão</strong><span class="revision-tag" id="revisionTag"></span></div><ul id="news"></ul><div class="validation" id="validation"></div></section>
<div class="workspace"><section class="panel" id="mapPanel"><div class="panel-head"><strong id="mapTitle">Mapa completo</strong><div class="toolbar"><button id="zoomOut" aria-label="Diminuir zoom">−</button><button id="fit">Ajustar</button><button id="compare" aria-pressed="false" disabled>Ver anterior</button><button id="one">1×</button><button id="two">2×</button><button id="zoomIn" aria-label="Aumentar zoom">+</button><button id="expand" aria-pressed="false">Ampliar</button></div></div><div class="map-wrap" id="mapWrap"><canvas id="map" tabindex="0" aria-label="Mapa interativo. Clique para posicionar a janela, arraste para deslocar e use as setas para explorar."></canvas><div class="coords" id="mapCoords"></div><div class="map-hint">Clique para inspecionar · arraste para deslocar · roda para zoom</div></div><div class="layers"><label><input id="showPoints" type="checkbox" checked> Objetivos</label><label><input id="showBounds" type="checkbox"> Área de combate</label><label><input id="showSolids" type="checkbox"> Colisões</label><label><input id="showRoute" type="checkbox"> Percurso de referência</label><label><input id="showViews" type="checkbox"> Capturas</label></div><div class="legend"><span style="color:var(--green)">● Entrada / destino</span><span style="color:var(--accent)">● Objetivo</span><span style="color:var(--blue)">▭ Janela selecionada 320 × 224</span></div></section>
<section class="panel"><div class="panel-head"><strong>Janela de inspeção</strong><span class="eyebrow">320 × 224</span></div><div class="inspector"><div class="inspector-layout"><div><div class="tabs" role="group" aria-label="Modo de inspeção"><button id="realMode" aria-pressed="true">Captura real</button><button id="baseMode" aria-pressed="false">Recorte livre</button></div><canvas class="screen" id="screen" width="320" height="224" aria-label="Inspeção ampliada da fase"></canvas><div class="screen-info" id="screenInfo" aria-live="polite"></div></div><div><div class="sliders"><label for="cameraX">X</label><input type="range" id="cameraX" min="0" step="1"><output id="xValue"></output><label for="cameraY">Y</label><input type="range" id="cameraY" min="0" step="1"><output id="yValue"></output></div><div class="jump"><button id="entry">Entrada</button><button id="middle">Centro</button><button id="end">Final do mapa</button></div><div class="view-controls"><button id="prevView" aria-label="Captura anterior">←</button><select id="viewSelect" aria-label="Selecionar captura do emulador"></select><button id="nextView" aria-label="Próxima captura">→</button></div><div class="stats"><div class="stat"><small>Dimensões</small><b id="dimensions"></b></div><div class="stat"><small>Capturas reais</small><b id="viewCount"></b></div><div class="stat"><small>Obstáculos</small><b id="solidCount"></b></div><div class="stat"><small>Cache / tiles de cenário</small><b id="tileCount"></b></div></div><p class="muted" style="font-size:10px;margin:10px 0 0">A captura real seleciona a câmera registrada mais próxima. O recorte livre mostra a arte base, sem HUD, atores ou mecanismos dinâmicos.</p></div></div></div><div class="panel-head"><strong>Pontos para explorar</strong></div><div class="points" id="points"></div></section></div>
<section class="thumb-section"><div><h3>Capturas dentro da fase</h3><p>Selecione uma imagem para localizar a câmera no mapa.</p></div><div class="filmstrip" id="filmstrip" aria-label="Galeria de capturas"></div></section>
<section class="panel evidence-section" id="evidenceSection" hidden><div class="panel-head"><strong>Evidências das novidades</strong><span class="eyebrow">Mesma ROM · NTSC</span></div><div class="evidence-body"><div><img class="evidence-image" id="evidenceImage" alt=""><div class="evidence-caption" id="evidenceCaption"></div></div><div><p class="muted" style="font-size:11px;margin:0 0 12px">Selecione um estado para inspecionar o piso do sindicato, geradores, barras, rádio, ignição e confronto. Imagens de ensaios funcionais com preparação por RAM, conferidos para a mesma ROM das novas capturas.</p><div class="evidence-choices" id="evidenceChoices"></div></div></div></section>
<details><summary>Origem dos mapas e método de captura</summary><p>As 19 versões foram abertas no Genesis Plus GX usando a mesma ROM de produção. Os mapas completos foram extraídos dos ponteiros de cenário da fase carregada, preservando tiles, paleta e dimensões. As capturas reais mostram a imagem produzida pelo emulador, incluindo HUD, personagens e mecanismos.</p><p>Para posicionar as câmeras, a ferramenta seleciona a fase, protege os atores e posiciona Damião por RAM antes de cada captura. Cada câmera restaura o mesmo estado inicial da fase. Esta é uma inspeção visual: não é uma partida completa, uma simulação de combate no navegador ou uma medição de desempenho. O mapa base é estático; consulte as capturas reais para os elementos dinâmicos. Os percursos de referência vêm dos dados de produção e não representam uma travessia executada nesta captura.</p><p>A fase 3 também pode herdar a igreja destruída, e as fases finais herdam o estado de Dinorah. As capturas desta página correspondem às variantes e ao contexto indicados acima. As colisões estáticas vêm da arena carregada; portões e outros obstáculos dinâmicos aparecem como pontos de objetivo.</p><p id="provenance"></p><p>SHA256 da ROM: <code id="romHash"></code></p></details>
</main></div>
<script id="atlasData" type="application/json">__ATLAS_DATA__</script>
<script>
'use strict';
const DATA=JSON.parse(document.getElementById('atlasData').textContent),STAGES=DATA.stages,$=id=>document.getElementById(id);
const map=$('map'),ctx=map.getContext('2d'),screen=$('screen'),sc=screen.getContext('2d');
let selected=0,showPrevious=false,baseImage=null,scale=1,offsetX=0,offsetY=0,cameraX=0,cameraY=0,mode='real',activeView=-1,entrySelected=true,loadSerial=0,framePending=false;
const imageCache=new Map();
function stage(){return STAGES[selected]}
function clamp(n,a,b){return Math.max(a,Math.min(b,n))}
function image(src){if(!imageCache.has(src)){const i=new Image();i.onload=redraw;i.onerror=()=>{$('screenInfo').textContent='Falha ao carregar imagem incorporada.'};i.src=src;imageCache.set(src,i)}return imageCache.get(src)}
function redraw(){if(!framePending){framePending=true;requestAnimationFrame(()=>{framePending=false;drawMap();drawScreen()})}}
function size(){return {w:$('mapWrap').clientWidth,h:$('mapWrap').clientHeight}}
function fit(){const d=stage().geometry,{w,h}=size();scale=Math.min((w-48)/d.width,(h-48)/d.height);offsetX=(w-d.width*scale)/2;offsetY=(h-d.height*scale)/2;redraw()}
function zoom(value,px,py){const {w,h}=size();px=px??w/2;py=py??h/2;const wx=(px-offsetX)/scale,wy=(py-offsetY)/scale;scale=clamp(value,.08,8);offsetX=px-wx*scale;offsetY=py-wy*scale;redraw()}
function nearestView(){let best=0,distance=Infinity;stage().views.forEach((v,i)=>{const dist=(v.camera[0]-cameraX)**2+(v.camera[1]-cameraY)**2;if(dist<distance){distance=dist;best=i}});return best}
function setCamera(x,y,nearest=true){const d=stage().geometry;cameraX=Math.round(clamp(x,0,d.width-320));cameraY=Math.round(clamp(y,0,d.height-224));entrySelected=false;if(nearest)activeView=nearestView();updateControls();redraw()}
function updateControls(){$('cameraX').value=cameraX;$('cameraY').value=cameraY;$('xValue').textContent=cameraX;$('yValue').textContent=cameraY;$('viewSelect').value=entrySelected?'entry':String(activeView);document.querySelectorAll('.thumb').forEach(b=>b.setAttribute('aria-pressed',b.dataset.view===(entrySelected?'entry':String(activeView))));$('prevView').disabled=entrySelected;$('nextView').disabled=!entrySelected&&activeView===stage().views.length-1}
function selectView(index){if(index==='entry'){entrySelected=true;activeView=-1;const p=stage().geometry.start;cameraX=stage().entry_camera?.[0]??clamp(p[0]-152,0,stage().geometry.width-320);cameraY=stage().entry_camera?.[1]??clamp(p[1]-131,0,stage().geometry.height-224)}else{entrySelected=false;activeView=Number(index);[cameraX,cameraY]=stage().views[activeView].camera}mode='real';setModeButtons();updateControls();redraw()}
function setModeButtons(){$('realMode').setAttribute('aria-pressed',mode==='real');$('baseMode').setAttribute('aria-pressed',mode==='base')}
function drawMap(){if(!baseImage)return;const {w,h}=size(),ratio=devicePixelRatio||1;if(map.width!==Math.round(w*ratio)||map.height!==Math.round(h*ratio)){map.width=Math.round(w*ratio);map.height=Math.round(h*ratio)}ctx.setTransform(ratio,0,0,ratio,0,0);ctx.clearRect(0,0,w,h);ctx.save();ctx.translate(offsetX,offsetY);ctx.scale(scale,scale);ctx.imageSmoothingEnabled=false;if(baseImage.complete&&baseImage.naturalWidth)ctx.drawImage(baseImage,0,0);const s=stage(),d=s.geometry;
if($('showBounds').checked){const [l,t,r,b]=d.bounds;ctx.fillStyle='#86c6ed17';ctx.strokeStyle='#86c6eda0';ctx.lineWidth=1.2/scale;ctx.fillRect(l,t,r-l,b-t);ctx.strokeRect(l,t,r-l,b-t)}
if($('showSolids').checked){for(const [x,y,w,h,shots]of d.solids){ctx.fillStyle=shots?'#f0776c5c':'#d5a0e45c';ctx.strokeStyle=shots?'#ff9c91':'#dab1ee';ctx.lineWidth=1/scale;ctx.fillRect(x,y,w,h);ctx.strokeRect(x,y,w,h)}}
if($('showRoute').checked&&s.route.length){ctx.beginPath();s.route.forEach(([x,y],i)=>i?ctx.lineTo(x,y):ctx.moveTo(x,y));ctx.lineWidth=2/scale;ctx.strokeStyle='#99dfbd';ctx.setLineDash([6/scale,4/scale]);ctx.stroke();ctx.setLineDash([])}
if($('showViews').checked){s.views.forEach(v=>{ctx.strokeStyle='#bbc8d255';ctx.lineWidth=1/scale;ctx.strokeRect(v.camera[0],v.camera[1],320,224)})}
if($('showPoints').checked){s.points.forEach((p,i)=>{const r=7/scale;ctx.fillStyle=['start','exit'].includes(p.kind)?'#93cdb0':'#edbc72';ctx.strokeStyle='#0c1013';ctx.lineWidth=2/scale;ctx.beginPath();ctx.arc(p.x,p.y,r,0,Math.PI*2);ctx.fill();ctx.stroke();if(scale>.32){ctx.fillStyle='#11171b';ctx.font=`bold ${8/scale}px system-ui`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(i+1,p.x,p.y+.5/scale)}})}
ctx.lineWidth=2/scale;ctx.strokeStyle='#86c6ed';ctx.shadowColor='#000';ctx.shadowBlur=4;ctx.strokeRect(cameraX,cameraY,320,224);ctx.shadowBlur=0;ctx.fillStyle='#86c6ed20';ctx.fillRect(cameraX,cameraY,320,224);
if(mode==='real'&&!entrySelected&&activeView>=0){const v=s.views[activeView];ctx.lineWidth=1/scale;ctx.strokeStyle='#fff';ctx.setLineDash([4/scale,3/scale]);ctx.strokeRect(v.camera[0],v.camera[1],320,224);ctx.setLineDash([])}ctx.restore();$('mapCoords').textContent=`${Math.round(scale*100)}% · ${d.width} × ${d.height} px`}
function drawScreen(){if(!baseImage)return;sc.imageSmoothingEnabled=false;sc.clearRect(0,0,320,224);if(mode==='base'){if(baseImage.complete)sc.drawImage(baseImage,cameraX,cameraY,320,224,0,0,320,224);$('screenInfo').textContent=`Arte base ${showPrevious?'anterior':'atual'} · X ${cameraX} / Y ${cameraY}. Sem atores, HUD ou mecanismos dinâmicos.`}else{const v=stage().views[activeView],src=entrySelected?stage().entry:v?.image;if(src){const i=image(src);if(i.complete&&i.naturalWidth)sc.drawImage(i,0,0,320,224)}$('screenInfo').textContent=entrySelected?'Entrada real na fase, antes do reposicionamento para inspeção.':`Captura ${activeView+1} / ${stage().views.length} · câmera X ${v.camera[0]} / Y ${v.camera[1]} · Damião ${v.player.join(', ')}.`}}
function chooseEvidence(index){const e=stage().evidence[index];$('evidenceImage').src=e.image;$('evidenceImage').alt=`Fase ${stage().id}: ${e.title}`;$('evidenceCaption').textContent=e.title;Array.from($('evidenceChoices').children).forEach((b,i)=>b.setAttribute('aria-pressed',i===index))}
function renderReview(s){
$('revisionTag').textContent={new:'Nova no atlas',updated:'Atualizada',recaptured:'Recapturada'}[s.revision.status];
$('news').replaceChildren();s.news.forEach(t=>{const li=document.createElement('li');li.textContent=t;$('news').append(li)});
if(s.total_tiles){const li=document.createElement('li');li.textContent=`Reserva total de cenário e mecanismos: ${s.total_tiles} / 640 tiles.`;$('news').append(li)}
$('validation').replaceChildren();$('validation').hidden=!s.validation.length;
s.validation.forEach(v=>{const p=document.createElement('p');const fps=v.fps_min===v.fps_max?String(v.fps_min):`${v.fps_min}–${v.fps_max}`;p.textContent=`${v.region}: ${v.check_count} verificações aprovadas · ${v.camera_views} câmeras · ${s.id==='16'?'combate':'carga configurada'} ${fps} FPS`;$('validation').append(p)});
if(s.validation.length){const info=document.createElement('small');info.textContent='Ensaios funcionais desta revisão em NTSC/PAL, com a mesma ROM das capturas. Hardware físico não testado.';$('validation').append(info)}
$('evidenceSection').hidden=!s.evidence.length;$('evidenceChoices').replaceChildren();s.evidence.forEach((e,i)=>{const b=document.createElement('button');b.textContent=e.title;b.onclick=()=>chooseEvidence(i);$('evidenceChoices').append(b)});if(s.evidence.length)chooseEvidence(0)
}
function select(index,hash=true){selected=clamp(index,0,STAGES.length-1);const s=stage(),d=s.geometry;loadSerial++;showPrevious=false;baseImage=image(s.map);$('mapTitle').textContent='Mapa completo';$('compare').disabled=!s.previous_map;$('compare').textContent='Ver anterior';$('compare').setAttribute('aria-pressed',false);renderReview(s);$('stageLabel').textContent=`Fase ${s.id} / ${selected+1} de ${STAGES.length} versões`;$('title').textContent=s.title;$('place').textContent=s.place;$('objective').textContent=s.objective;$('note').textContent=s.note;$('dimensions').textContent=`${d.width} × ${d.height}`;$('viewCount').textContent=s.views.length+1;$('solidCount').textContent=d.solids.length;$('tileCount').textContent=`${s.source.resident_tile_budget} / 640`;$('previous').disabled=selected===0;$('next').disabled=selected===STAGES.length-1;$('cameraX').max=d.width-320;$('cameraY').max=d.height-224;
document.querySelectorAll('.stage-btn').forEach((b,i)=>{b.setAttribute('aria-pressed',i===selected);if(i===selected)b.setAttribute('aria-current','true');else b.removeAttribute('aria-current')});
$('points').replaceChildren();s.points.forEach((p,i)=>{const b=document.createElement('button');b.textContent=`${i+1}. ${p.label}`;b.dataset.kind=p.kind;b.title=`X ${p.x}, Y ${p.y}`;b.onclick=()=>{setCamera(p.x-160,p.y-124);$('showPoints').checked=true};$('points').append(b)});
$('viewSelect').replaceChildren();const entryOpt=document.createElement('option');entryOpt.value='entry';entryOpt.textContent='Entrada original';$('viewSelect').append(entryOpt);s.views.forEach((v,i)=>{const o=document.createElement('option');o.value=i;o.textContent=`${i+1}. Câmera ${v.camera.join(', ')}`;$('viewSelect').append(o)});
$('filmstrip').replaceChildren();const items=[{image:s.entry,title:'Entrada original',value:'entry'},...s.views.map((v,i)=>({image:v.image,title:`${i+1} · X ${v.camera[0]} / Y ${v.camera[1]}`,value:String(i)}))];items.forEach(v=>{const b=document.createElement('button');b.className='thumb';b.dataset.view=v.value;const im=document.createElement('img');im.src=v.image;im.alt=`Fase ${s.id} · ${v.title}`;im.loading='lazy';const t=document.createElement('span');t.textContent=v.title;b.append(im,t);b.onclick=()=>selectView(v.value);$('filmstrip').append(b)});selectView('entry');fit();if(hash)history.replaceState(null,'',`#fase-${s.id.toLowerCase()}`)}
STAGES.forEach((s,i)=>{const b=document.createElement('button');b.className='stage-btn';b.dataset.status=s.revision.status;b.setAttribute('aria-label',`Fase ${s.id}: ${s.title}`);const n=document.createElement('b'),t=document.createElement('span');n.textContent=s.id;t.textContent=s.place+(s.revision.status==='new'?' · nova':s.revision.status==='updated'?' · atualizada':'');b.append(n,t);b.onclick=()=>select(i);$('stages').append(b)});
$('compare').onclick=()=>{showPrevious=!showPrevious;baseImage=image(showPrevious?stage().previous_map:stage().map);$('compare').textContent=showPrevious?'Ver atual':'Ver anterior';$('compare').setAttribute('aria-pressed',showPrevious);$('mapTitle').textContent=showPrevious?'Mapa anterior · comparação':'Mapa completo';mode='base';setModeButtons();redraw()};
$('previous').onclick=()=>select(selected-1);$('next').onclick=()=>select(selected+1);$('fit').onclick=fit;$('one').onclick=()=>zoom(1);$('two').onclick=()=>zoom(2);$('zoomIn').onclick=()=>zoom(scale*1.35);$('zoomOut').onclick=()=>zoom(scale/1.35);
$('expand').onclick=()=>{const on=$('mapPanel').classList.toggle('fullscreen');$('expand').textContent=on?'Recolher':'Ampliar';$('expand').setAttribute('aria-pressed',on);fit()};
for(const id of ['showPoints','showBounds','showSolids','showRoute','showViews'])$(id).onchange=redraw;
$('cameraX').oninput=e=>setCamera(Number(e.target.value),cameraY);$('cameraY').oninput=e=>setCamera(cameraX,Number(e.target.value));
$('entry').onclick=()=>selectView('entry');$('middle').onclick=()=>setCamera((stage().geometry.width-320)/2,(stage().geometry.height-224)/2);$('end').onclick=()=>setCamera(stage().geometry.width-320,(stage().geometry.height-224)/2);
$('viewSelect').onchange=e=>selectView(e.target.value);$('prevView').onclick=()=>selectView(activeView<=0?'entry':String(activeView-1));$('nextView').onclick=()=>selectView(String(entrySelected?0:Math.min(stage().views.length-1,activeView+1)));
$('realMode').onclick=()=>{mode='real';setModeButtons();redraw()};$('baseMode').onclick=()=>{mode='base';setModeButtons();redraw()};
let drag=null;map.onpointerdown=e=>{map.setPointerCapture(e.pointerId);drag={x:e.clientX,y:e.clientY,ox:offsetX,oy:offsetY,moved:false}};map.onpointermove=e=>{if(!drag)return;const dx=e.clientX-drag.x,dy=e.clientY-drag.y;if(Math.abs(dx)+Math.abs(dy)>4)drag.moved=true;if(drag.moved){offsetX=drag.ox+dx;offsetY=drag.oy+dy;redraw()}};map.onpointerup=e=>{if(!drag)return;if(!drag.moved){const r=map.getBoundingClientRect(),x=(e.clientX-r.left-offsetX)/scale,y=(e.clientY-r.top-offsetY)/scale;setCamera(x-160,y-124)}drag=null};map.onpointercancel=()=>drag=null;
map.addEventListener('wheel',e=>{e.preventDefault();const r=map.getBoundingClientRect();zoom(scale*(e.deltaY<0?1.15:1/1.15),e.clientX-r.left,e.clientY-r.top)},{passive:false});
document.addEventListener('keydown',e=>{if(['INPUT','SELECT','TEXTAREA','BUTTON'].includes(e.target.tagName))return;const moves={ArrowLeft:[-16,0],ArrowRight:[16,0],ArrowUp:[0,-16],ArrowDown:[0,16]};if(moves[e.key]){e.preventDefault();setCamera(cameraX+moves[e.key][0],cameraY+moves[e.key][1])}else if(e.key==='+'||e.key==='=')zoom(scale*1.35);else if(e.key==='-')zoom(scale/1.35);else if(e.key==='Escape'&&$('mapPanel').classList.contains('fullscreen'))$('expand').click()});
new ResizeObserver(()=>fit()).observe($('mapWrap'));window.addEventListener('hashchange',()=>{const i=STAGES.findIndex(s=>`#fase-${s.id.toLowerCase()}`===location.hash);if(i>=0)select(i,false)});
$('captureBadge').textContent=`${DATA.view_count} capturas + ${DATA.evidence_count} evidências`;$('revisionSummary').textContent=`Fases novas: ${DATA.comparison.added.join(' e ')} · Atualizadas: ${DATA.comparison.updated.join(', ')} · Todas as 19 versões recapturadas da mesma ROM.`;$('romHash').textContent=DATA.rom;$('provenance').textContent=`Gerado em ${DATA.generated} (São Paulo). Região: ${DATA.region}. Comparação com o atlas anterior e ensaios funcionais das fases 13–16 executados nesta revisão, todos com a mesma SHA256. Todas as imagens e os dados estão incorporados; não exige internet nem servidor.`;
const initial=STAGES.findIndex(s=>`#fase-${s.id.toLowerCase()}`===location.hash);select(initial<0?0:initial);
</script>
</body></html>
